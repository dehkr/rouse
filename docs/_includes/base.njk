<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="alternate" type="text/markdown" href="/index.md">
  <link rel="stylesheet" href="/assets/style.css">
  <script>
    // Runs before paint, so a saved theme doesn't flash the system one first
    try {
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.dataset.theme = saved;
    } catch {}
  </script>
</head>
<body>
  <div class="controls">
    <div class="toc">
      <input class="toc-input" type="text" role="combobox" aria-label="Jump to section" aria-controls="toc-list" aria-expanded="false" aria-autocomplete="list" placeholder="Type /" autocomplete="off" spellcheck="false">
      <div class="toc-popup">
        <ul id="toc-list" class="toc-list" role="listbox" aria-label="Sections"></ul>
        <p class="toc-empty" hidden>No matching sections</p>
      </div>
    </div>
    <div class="theme-toggle" role="group" aria-label="Color theme" data-rz-scope="theme-toggle">
      <button type="button" data-rz-on="click: setTheme" data-rz-attr="aria-pressed: pressed" data-theme-value="light" aria-label="Light mode" title="Light mode"></button>
      <button type="button" data-rz-on="click: setTheme" data-rz-attr="aria-pressed: pressed" data-theme-value="dark" aria-label="Dark mode" title="Dark mode"></button>
    </div>
  </div>
  <main>{{ content | safe }}</main>
  <script type="module">
  import { rouse, signal } from '/assets/rouse.js';

  const app = rouse();

  app.scope('theme-toggle', () => {
    const systemDark = matchMedia('(prefers-color-scheme: dark)');
    const system = signal(systemDark.matches ? 'dark' : 'light');
    // Until a theme is picked, the selection follows the system setting
    systemDark.addEventListener('change', (e) => system(e.matches ? 'dark' : 'light'));
    const picked = signal(app.root.dataset.theme);

    return {
      setTheme({ el }) {
        const theme = el.dataset.themeValue;
        picked(theme);
        app.root.dataset.theme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch {}
      },
      pressed({ el }) {
        return el.dataset.themeValue === (picked() ?? system());
      },
    };
  });

  app.start();
  </script>
  <script>
    // Focusing the input (a click or `/`) opens the section list. Typing filters it, ↑/↓ move the
    // highlight, and Enter or a click scrolls to the section; nothing scrolls before that
    const toc = document.querySelector('.toc');
    const input = toc.querySelector('.toc-input');
    const popup = toc.querySelector('.toc-popup');
    const list = toc.querySelector('.toc-list');
    const empty = toc.querySelector('.toc-empty');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const norm = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

    const sections = [...document.querySelectorAll('main :is(h2, h3)[id]')].map((el) => {
      const option = document.createElement('li');
      option.id = `toc-${el.id}`;
      option.setAttribute('role', 'option');
      option.className = el.tagName === 'H3' ? 'toc-sub' : '';
      option.textContent = el.textContent.trim();
      return { el, option, text: norm(el.textContent), level: el.tagName === 'H2' ? 0 : 1 };
    });
    list.replaceChildren(...sections.map((s) => s.option));

    let shown = [];
    let active = -1;

    // 0: title prefix, 1: word prefix, 2: letters in order, -1: no match
    function rank(text, q) {
      if (text.startsWith(q)) return 0;
      if (` ${text}`.includes(` ${q}`)) return 1;
      const letters = q.replaceAll(' ', '');
      let i = 0;
      for (const c of text) if (c === letters[i]) i++;
      return i === letters.length ? 2 : -1;
    }

    // The list keeps page order so its structure stays readable; the highlight goes
    // to the best match, so Enter picks it
    function filter() {
      const q = norm(input.value);
      const ranked = sections.map((s) => ({ s, r: q ? rank(s.text, q) : 0 }));
      ranked.forEach(({ s, r }) => {
        s.option.hidden = r < 0;
      });
      const hits = ranked.filter(({ r }) => r >= 0);
      shown = hits.map(({ s }) => s);
      empty.hidden = shown.length > 0;

      let best = -1;
      if (q) {
        hits.forEach(({ s, r }, i) => {
          const b = hits[best];
          if (!b || r < b.r || (r === b.r && s.level < b.s.level)) best = i;
        });
      }
      highlight(best);
    }

    function highlight(i) {
      // Found by query, not by index: `shown` may have been refiltered since
      list.querySelector('[aria-selected]')?.removeAttribute('aria-selected');
      active = i;
      const option = shown[active]?.option;
      if (option) {
        option.setAttribute('aria-selected', 'true');
        option.scrollIntoView({ block: 'nearest' });
        input.setAttribute('aria-activedescendant', option.id);
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    }

    function open() {
      input.placeholder = 'Jump to section';
      input.setAttribute('aria-expanded', 'true');
      filter();
      list.scrollTop = 0;
    }

    function close() {
      input.value = '';
      input.placeholder = 'Type /';
      input.setAttribute('aria-expanded', 'false');
      highlight(-1);
    }

    function go({ el }) {
      close();
      el.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
      if (location.hash !== `#${el.id}`) history.pushState(null, '', `#${el.id}`);
      // Focus follows, so Tab continues from the section; preventScroll keeps the smooth scroll
      el.tabIndex = -1;
      el.focus({ preventScroll: true });
      el.classList.remove('toc-target');
      void el.offsetWidth; // reflow, so landing on the same heading again restarts the flash
      el.classList.add('toc-target');
    }

    input.addEventListener('focus', open);
    input.addEventListener('input', filter);

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!shown.length) return;
        const step = e.key === 'ArrowDown' ? 1 : shown.length - 1;
        highlight(active < 0 ? (step === 1 ? 0 : shown.length - 1) : (active + step) % shown.length);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (shown[active]) go(shown[active]);
      } else if (e.key === 'Escape') {
        input.blur();
      }
    });

    // Keeps focus in the input, so the click lands before focusout closes the list
    popup.addEventListener('mousedown', (e) => e.preventDefault());
    list.addEventListener('click', (e) => {
      const section = sections.find((s) => s.option === e.target.closest('[role="option"]'));
      if (section) go(section);
    });

    toc.addEventListener('focusout', (e) => {
      if (!toc.contains(e.relatedTarget)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
      const t = e.target;
      if (t.isContentEditable || t.closest('input, textarea, select')) return;
      e.preventDefault();
      input.focus();
    });
  </script>
</body>
</html>
