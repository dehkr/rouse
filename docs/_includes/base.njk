<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="alternate" type="text/markdown" href="/index.md">
  <link rel="stylesheet" href="/assets/style.css">
  <script>
    // Runs before paint, so a saved theme doesn't flash the system one first
    try {
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.dataset.theme = saved;
    } catch {}
  </script>
  <script type="module">
    import { rouse, signal, reactive } from '/assets/rouse.js';

    const norm = (string) => string.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    const app = rouse();
    
    // Manages the theme picker buttons. Saves selection to local storage.
    // Respects the system setting until a theme is picked.
    app.scope('theme-toggle', ({ app }) => {
      const systemDark = matchMedia('(prefers-color-scheme: dark)');
      const system = signal(systemDark.matches ? 'dark' : 'light');
      const picked = signal(app.root.dataset.theme);
      
      systemDark.addEventListener('change', (e) => system(e.matches ? 'dark' : 'light'));

      return {
        setTheme({ el }) {
          const theme = el.dataset.themeValue;
          picked(theme);
          app.root.dataset.theme = theme;
          try {
            localStorage.setItem('theme', theme);
          } catch {}
        },
        pressed({ el }) {
          return el.dataset.themeValue === (picked() ?? system());
        },
      };
    });

    // Focusing the input (a click or `/`) opens the section list. Typing filters it, ↑/↓ move the
    // highlight, and Enter or a click scrolls to the section; nothing scrolls before that.
    app.scope('heading-jump', ({ host }) => {
      const tocList = host.querySelector('#toc-list');
      const items = [...document.querySelectorAll('main :is(h2, h3)[id]')].map((heading) => ({
        heading,
        id: `toc-${heading.id}`,
        sub: heading.tagName === 'H3',
        text: heading.textContent,
        normalized: norm(heading.textContent),
      }));

      const list = reactive({
        expanded: false,
        shown: [],
        active: -1,
        query: '',
        get placeholder() {
          return this.expanded ? 'Jump to section' : 'Type /';
        },
        get activeId() {
          return this.shown[this.active]?.id ?? null;
        },
      });

      // 0: title prefix, 1: word prefix, 2: letters in order, -1: no match
      function rank(text, query) {
        if (text.startsWith(query)) return 0;
        if (` ${text}`.includes(` ${query}`)) return 1;

        const letters = query.replaceAll(' ', '');
        
        let i = 0;
        for (const c of text) {
          if (c === letters[i]) i++;
        }

        return i === letters.length ? 2 : -1;
      }

      // The list keeps page order so its structure stays readable; the highlight
      // goes to the best match, so Enter picks it
      function filter() {
        const query = norm(list.query);
        const ranked = items.map((item) => ({
          item,
          rank: query ? rank(item.normalized, query) : 0,
        }));
        const hits = ranked.filter(({ rank }) => rank >= 0);

        list.shown = hits.map(({ item }) => item);

        let best = -1;
        if (query) {
          hits.forEach(({ item, rank }, i) => {
            const b = hits[best];
            if (!b || rank < b.rank || (rank === b.rank && !item.sub && b.item.sub)) {
              best = i;
            }
          });
        }
        highlight(best);
      }

      function highlight(index) {
        list.active = index;
        if (list.activeId) {
          document.getElementById(list.activeId)?.scrollIntoView({ block: 'nearest' });
        }
      }

      function open() {
        filter();
        list.expanded = true;
        tocList.scrollTop = 0;
      }

      function close() {
        list.expanded = false;
        list.query = '';
        highlight(-1);
      }

      function step(delta) {
        const n = list.shown.length;
        if (!n) return;
        highlight(list.active < 0 ? (delta > 0 ? 0 : n - 1) : (list.active + delta + n) % n);
      }

      function go({ heading }) {
        close();
        heading.scrollIntoView({ 
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        });
        if (location.hash !== `#${heading.id}`) {
          history.pushState(null, '', `#${heading.id}`);
        }
        // Focus follows, so Tab continues from the section; preventScroll keeps the smooth scroll
        heading.tabIndex = -1;
        heading.focus({ preventScroll: true });
        heading.classList.remove('toc-target');
        // Reflow, so landing on the same heading again restarts the flash
        void heading.offsetWidth; 
        heading.classList.add('toc-target');
      }

      return {
        list,
        open,
        close,
        filter,
        prev: () => step(-1),
        next: () => step(1),
        dismiss: ({ el }) => el.blur(),
        hasResults: () => list.shown.length > 0,
        selected: ({ render }) => render.item.id === list.activeId,
        pick: ({ render }) => go(render.item),
        pickActive: () => {
          const item = list.shown[list.active];
          if (item) go(item);
        },
        shortcut: ({ e, el }) => {
          const t = e.target;
          if (t.isContentEditable || t.closest('input, textarea, select')) return;
          e.preventDefault();
          el.focus();
        },
      };
    });

    app.start();
  </script>
</head>
<body>
  <div class="controls">
    <div class="toc" data-rz-scope="heading-jump" data-rz-on="focusout: close">
      <input
        id="toc-input"
        class="toc-input"
        type="text"
        role="combobox"
        data-rz-model="list.query"
        data-rz-on="
          focus: open,
          input: filter,
          keydown|key-[/].window: shortcut,
          keydown|key-[arrowdown].prevent: next,
          keydown|key-[arrowup].prevent: prev,
          keydown|key-[escape].prevent: dismiss,
          keydown|key-[enter].prevent: pickActive,
        "
        data-rz-attr="
          placeholder: list.placeholder,
          aria-expanded: list.expanded,
          aria-activedescendant: list.activeId,
        "
        aria-label="Jump to section"
        aria-controls="toc-list"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
      >
      <div class="toc-popup" data-rz-on="mousedown|prevent">
        <ul id="toc-list" class="toc-list" role="listbox" aria-label="Sections">
          <template data-rz-render="list.shown" data-rz-key="id">
            <li
              role="option"
              data-rz-attr="id: %.id, aria-selected: selected"
              data-rz-class="toc-sub: %.sub"
              data-rz-text="%.text"
              data-rz-on="click: pick"
            ></li>
          </template>
        </ul>
        <p class="toc-empty" data-rz-attr="hidden: hasResults">No matching items</p>
      </div>
    </div>
    <div class="theme-toggle" role="group" aria-label="Color theme" data-rz-scope="theme-toggle">
      <button type="button" data-rz-on="click: setTheme" data-rz-attr="aria-pressed: pressed" data-theme-value="light" aria-label="Light mode" title="Light mode"></button>
      <button type="button" data-rz-on="click: setTheme" data-rz-attr="aria-pressed: pressed" data-theme-value="dark" aria-label="Dark mode" title="Dark mode"></button>
    </div>
  </div>
  <main>{{ content | safe }}</main>
</body>
</html>
