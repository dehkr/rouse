{
  "name": "rousejs",
  "version": "0.16.0",
  "description": "JavaScript reactivity and state sync for server-rendered HTML",
  "keywords": [
    "alpinejs",
    "buildless",
    "csp",
    "declarative",
    "directives",
    "html-first",
    "htmx",
    "hypermedia",
    "micro-frontends",
    "mpa",
    "multi-page-app",
    "no-build",
    "reactive",
    "reactivity",
    "server-rendered",
    "server-sent-events",
    "signals",
    "sse",
    "state-management",
    "state-sync",
    "stimulus",
    "two-way-binding",
    "typescript"
  ],
  "homepage": "https://rousejs.com",
  "license": "MIT",
  "author": "dehkr <dehkr25@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dehkr/rouse.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/rouse.min.js",
  "types": "./dist/rouse.d.ts",
  "exports": {
    ".": {
      "types": "./dist/rouse.d.ts",
      "development": "./dist/rouse.js",
      "production": "./dist/rouse.min.js",
      "import": "./dist/rouse.min.js"
    },
    "./dev": {
      "types": "./dist/rouse.d.ts",
      "import": "./dist/rouse.js"
    },
    "./min": {
      "types": "./dist/rouse.d.ts",
      "import": "./dist/rouse.min.js"
    }
  },
  "scripts": {
    "build": "pnpm run types && pnpm run check && vp pack",
    "check": "vp check",
    "format": "vp fmt",
    "test": "vp test",
    "types": "tsc && tsc -p test",
    "docs:dev": "eleventy --serve",
    "docs:types": "tsc -p docs/scopes",
    "docs:build": "eleventy",
    "docs:release": "pnpm run docs:build && date -u +%FT%TZ > docs/rebuild.txt",
    "docs:vendor": "cp dist/* docs/assets/rouse/"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "alien-signals": "^3.2.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
