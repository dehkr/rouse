{
  "name": "rousejs",
  "version": "0.16.0",
  "description": "JavaScript reactivity and state sync for server-rendered HTML",
  "author": "dehkr <dehkr25@gmail.com>",
  "license": "MIT",
  "keywords": [
    "hypermedia",
    "server-rendered",
    "mpa",
    "multi-page-app",
    "html-first",
    "reactivity",
    "reactive",
    "signals",
    "state-management",
    "state-sync",
    "sse",
    "server-sent-events",
    "two-way-binding",
    "directives",
    "declarative",
    "csp",
    "buildless",
    "no-build",
    "progressive-enhancement",
    "micro-frontends",
    "typescript",
    "htmx",
    "alpinejs",
    "stimulus"
  ],
  "homepage": "https://rousejs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dehkr/rouse.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "main": "./dist/rouse.min.js",
  "types": "./dist/rouse.d.ts",
  "exports": {
    ".": {
      "types": "./dist/rouse.d.ts",
      "development": "./dist/rouse.js",
      "production": "./dist/rouse.min.js",
      "import": "./dist/rouse.min.js"
    },
    "./dev": {
      "types": "./dist/rouse.d.ts",
      "import": "./dist/rouse.js"
    },
    "./min": {
      "types": "./dist/rouse.d.ts",
      "import": "./dist/rouse.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run types && pnpm run check && tsup",
    "check": "biome check",
    "format": "biome format --write",
    "types": "tsc",
    "docs:dev": "eleventy --serve",
    "docs:types": "tsc -p docs/scopes",
    "docs:build": "eleventy",
    "docs:vendor": "cp dist/* docs/assets/rouse/"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@biomejs/biome": "2.4.4",
    "alien-signals": "^3.1.2",
    "esbuild": "^0.28.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
